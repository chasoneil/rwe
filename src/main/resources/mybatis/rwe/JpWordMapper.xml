<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.chason.rwe.dao.JpWordDao">

	<select id="get" resultType="com.chason.rwe.domain.JpWordDO">
		select `id`, `word`, `word_cn`, `word_type`, `word_voice`, `zh_mean`, `lesson_id`,
        `learn_time`, `learned`,`last_review_time`,`create_time` from tbl_jp_word where id = #{value}
	</select>

	<select id="list" resultType="com.chason.rwe.domain.JpWordDO">
		select `id`, `word`, `word_cn`, `word_type`, `word_voice`, `zh_mean`, `lesson_id`,
        `learn_time`,`learned`, `last_review_time`,`create_time` from tbl_jp_word
		<where>
			<if test="word != null and word != ''"> and word = #{word} </if>
			<if test="word_type != null and word_type != ''"> and wordType = #{wordType} </if>
			<if test="lesson != null and lesson != ''"> and lesson = #{lesson} </if>
			<if test="learned != null and learned != ''"> and learned = #{learned} </if>
			<if test="learn_time != null and learn_time != ''"> and learnTime = #{learnTime} </if>
			<if test="last_review_time != null and last_review_time != ''"> and lastReviewTime = #{lastReviewTime} </if>
		</where>
		<choose>
			<when test="sort != null and sort.trim() != ''">
				order by ${sort} ${order}
			</when>
			<otherwise>
				order by create_time
			</otherwise>
		</choose>
		<if test="offset != null and limit != null">
			limit #{offset}, #{limit}
		</if>
	</select>

	<select id="count" resultType="int">
		select count(*) from tbl_jp_word
		<where>
			<if test="word != null and word != ''"> and word = #{word} </if>
			<if test="word_type != null and word_type != ''"> and wordType = #{wordType} </if>
			<if test="lesson != null and lesson != ''"> and lesson = #{lesson} </if>
			<if test="learned != null and learned != ''"> and learned = #{learned} </if>
			<if test="learn_time != null and learn_time != ''"> and learnTime = #{learnTime} </if>
			<if test="last_review_time != null and last_review_time != ''"> and lastReviewTime = #{lastReviewTime} </if>
		</where>
	</select>

	<insert id="save" parameterType="com.chason.rwe.domain.JpWordDO">
		insert into tbl_jp_word
		(
			`id`, `word`, `word_cn`, `word_type`, `word_voice`, `zh_mean`, `lesson_id`,
            `learn_time`, `learned`, `last_review_time`, `create_time`
		)
		values
		(
			#{id}, #{word}, #{wordCn}, #{wordType}, #{wordVoice},  #{zhMean}, #{lessonId},
            #{learnTime}, #{learned}, #{lastReviewTime}, #{createTime}
		)
	</insert>

    <update id="update" parameterType="com.chason.rwe.domain.JpWordDO">
        update tbl_jp_word
        <set>
            <if test="word != null">`word` = #{word}, </if>
            <if test="wordCn != null">`word_cn` = #{wordCn}, </if>
            <if test="wordType != null">`word_type` = #{wordType}, </if>
            <if test="wordVoice != null">`word_voice` = #{wordVoice}, </if>
            <if test="zhMean != null"> `zh_mean` = #{zhMean} </if>
        </set>
        where id = #{id}
    </update>

	<delete id="removeByLesson">
		delete from tbl_jp_word where `lesson_id` = #{lessonId}
	</delete>

	<delete id="remove">
		delete from tbl_jp_word where `id` = #{value}
	</delete>

</mapper>
