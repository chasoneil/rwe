<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.chason.rwe.dao.DeepTypeDao">

	<select id="get" resultType="com.chason.rwe.domain.DeepTypeDO">
		select `id`, `user_id`, `deep_type_name`
		from tbl_deep_type
		where id = #{value}
	</select>

	<select id="list" resultType="com.chason.rwe.domain.DeepTypeDO">
		select `id`, `user_id`, `deep_type_name`
		from tbl_deep_type
		<where>
			<if test="userId != null"> and user_id = #{userId} </if>
			<if test="deepTypeName != null and deepTypeName != ''"> and deep_type_name = #{deepTypeName} </if>
		</where>
		order by id
		<if test="offset != null and limit != null">
			limit #{offset}, #{limit}
		</if>
	</select>

	<select id="count" resultType="int">
		select count(*)
		from tbl_deep_type
		<where>
			<if test="userId != null"> and user_id = #{userId} </if>
			<if test="deepTypeName != null and deepTypeName != ''"> and deep_type_name = #{deepTypeName} </if>
		</where>
	</select>

	<insert id="save" parameterType="com.chason.rwe.domain.DeepTypeDO">
		insert into tbl_deep_type
		(
			`user_id`,
			`deep_type_name`
		)
		values
			(
				#{userId},
				#{deepTypeName}
			)
	</insert>

	<update id="update" parameterType="com.chason.rwe.domain.DeepTypeDO">
		update tbl_deep_type
		<set>
			<if test="userId != null">`user_id` = #{userId}, </if>
			<if test="deepTypeName != null">`deep_type_name` = #{deepTypeName} </if>
		</set>
		where id = #{id}
	</update>

	<delete id="remove">
		delete from tbl_deep_type where id = #{value}
	</delete>

	<delete id="batchRemove">
		delete from tbl_deep_type where id in
		<foreach item="id" collection="array" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>

</mapper>
